<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.7" />
    <!-- Required for Windows DPAPI credential migration and LocalMachine service access. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ignore local scratch, downloaded, and backup C# files so they cannot break the HomeWatch build. -->
    <Compile Remove="g.cs" />
    <Compile Remove="Program.fixed.cs" />
    <Compile Remove="Program_old.cs" />
    <Compile Remove="Program_backup.cs" />
    <Compile Remove="**/*.bak.cs" />
  </ItemGroup>
  <Target Name="FixRootDomainReference" BeforeTargets="CoreCompile" Condition="Exists('$(MSBuildProjectDirectory)\Program.cs')">
    <Exec Command="powershell -NoProfile -Command &quot;$p='$(MSBuildProjectDirectory)\Program.cs'; $c=[IO.File]::ReadAllText($p); $c=$c.Replace('new AdultClassification(false, 100, RootDomain(item.Domain),','new AdultClassification(false, 100, DomainHelpers.RootDomain(item.Domain),'); [IO.File]::WriteAllText($p,$c)&quot;" />
  </Target>
</Project>